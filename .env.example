# =================================
# 猎头公司管理智能系统 - 环境变量模板
# 复制为 .env 并填入真实值
# =================================

# 数据库
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=yzschros
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_NAME=yzschros

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO 对象存储
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=yzschros

# JWT 认证 (必须修改，否则应用拒绝启动)
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# AI 服务
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_EMBEDDING_MODEL=embedding-3
OPENAI_API_KEY=your-openai-api-key

# 应用配置
API_PORT=3001
WEB_PORT=3003
NODE_ENV=development
